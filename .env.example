NODE_ENV=production
PORT=8080

# Canonical ARI / Mercury identity
SIOS_OWNER_GID=399152573423
ARI_REQUIRE_AUTH=true
ARI_SESSION_TTL_SECONDS=43200
SECURE_GATEWAY_INNER_PORT=8086
CONTROL_PLANE_INNER_PORT=8084
# Retrograde owns 8087 when wrapped by subscription entitlement and places
# Universal on 8089 so it never collides with the 8086 secure/control boundary.
RETROGRADE_GATEWAY_INNER_PORT=8089

# Public frontend origin used for Stripe return URLs.
PUBLIC_DOMAIN=https://siaas.space

# Secret values belong in Google Secret Manager and are mounted into Cloud Run with --update-secrets.
ARI_SESSION_SECRET=secret_manager:ari-session-secret
OWNER_ACCESS_CODE=secret_manager:ari-owner-access-code

# Neon Postgres is the canonical Jahorin persistence, access, registry, scene, device and control-plane authority.
NEON_DATABASE_URL=secret_manager:ari-neon-database-url
NEON_POOL_MAX=5

# Neon Auth is already provisioned on the SIOS production branch.
NEON_AUTH_URL=https://ep-fragrant-recipe-ak4pobky.neonauth.c-3.us-west-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-fragrant-recipe-ak4pobky.neonauth.c-3.us-west-2.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Legacy Supabase member-auth compatibility. Jahorin authorization and Twin persistence remain Neon-authoritative.
SUPABASE_URL=https://zrkkilsynurpgwrijicq.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=secret_manager:ari-supabase-secret-key
SUPABASE_SERVICE_ROLE_KEY=secret_manager:ari-supabase-service-role-key

# Canonical Stripe Billing. Secret key and webhook secret are server-only.
STRIPE_SECRET_KEY=secret_manager:ari-stripe-secret-key
STRIPE_WEBHOOK_SECRET=secret_manager:ari-stripe-webhook-secret
STRIPE_PRICE_PERSONAL=price_replace_with_personal_price_id
STRIPE_PRICE_PRO=price_replace_with_pro_price_id
STRIPE_PRICE_BUSINESS=price_replace_with_business_price_id
STRIPE_PRICE_ENTERPRISE=price_replace_with_enterprise_price_id

# Google Vertex AI is the verified production provider on Cloud Run and uses service identity, not a browser credential.
GOOGLE_CLOUD_PROJECT=689058655022
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# Optional Gemini Developer API fallback. If enabled, mount it from Secret Manager.
GEMINI_API_KEY=secret_manager:ari-gemini-api-key

# GA production browser origins. Preview/development origins are not accepted when NODE_ENV=production.
PRODUCTION_ALLOWED_ORIGINS=https://siaas.space,https://www.siaas.space,https://siaas.netlify.app,https://main--siaas.netlify.app
ALLOWED_ORIGINS=http://localhost:5173

# ARI bounded autonomy.
ARI_AUTONOMY_ENABLED=true
ARI_AUTONOMY_MAX_STEPS=8
ARI_AUTONOMY_MAX_RETRIES=2
ARI_AUTONOMY_SNAPSHOT_PATH=/tmp/ari-autonomy-state.json

# Cloud Tasks dispatch is optional.
ARI_PUBLIC_URL=https://ari-689058655022.us-west1.run.app
ARI_TASKS_LOCATION=us-west1
ARI_TASKS_QUEUE=ari-autonomy
ARI_TASKS_SERVICE_ACCOUNT=
ARI_WORKER_TOKEN=secret_manager:ari-worker-token

# MA'AT lifecycle proof trigger: 2026-08-28 internal free-tier verification.
