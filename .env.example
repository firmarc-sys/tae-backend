# Agentic Mercury TimeRunner
# Copy to .env for local development. Never commit real credentials.

# ── Runtime ────────────────────────────────────────────────────
APP_NAME=Agentic Mercury TimeRunner
APP_ENV=development
DEBUG=0
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

# Run with the in-memory repository until a free Supabase project is connected.
SIOS_ENABLE_DB=0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/timerunner

# Generate a strong random value before enabling accounts or deployment.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# ── Free database, identity, storage, and realtime ──────────────
DATA_PROVIDER=supabase
AUTH_PROVIDER=supabase
STORAGE_PROVIDER=supabase
REALTIME_PROVIDER=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── TAE / J A . i intelligence ─────────────────────────────────
# "fallback" runs the deterministic local command engine with no API key.
# Change to "gemini" after adding GEMINI_API_KEY.
AI_PROVIDER=fallback
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Free weather and environmental signals ─────────────────────
# NWS is the production-safe U.S. provider.
WEATHER_PROVIDER=nws
NWS_API_BASE=https://api.weather.gov
NWS_USER_AGENT=AgenticMercuryTimeRunner/1.0

# Open-Meteo is a global development fallback. Review its commercial terms
# before using its public endpoint in a paid product.
WEATHER_GLOBAL_FALLBACK=open-meteo
OPEN_METEO_API_BASE=https://api.open-meteo.com/v1

EARTHQUAKE_PROVIDER=usgs
USGS_EARTHQUAKE_API_BASE=https://earthquake.usgs.gov/fdsnws/event/1

SPACE_PROVIDER=nasa
NASA_API_BASE=https://api.nasa.gov
NASA_API_KEY=DEMO_KEY

ENERGY_PROVIDER=nrel
NREL_API_BASE=https://developer.nrel.gov/api
NREL_API_KEY=DEMO_KEY

# ── Maps and location ───────────────────────────────────────────
MAP_DATA_PROVIDER=openstreetmap
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GEOCODER_PROVIDER=nominatim
NOMINATIM_API_BASE=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=AgenticMercuryTimeRunner/1.0
NOMINATIM_MAX_REQUESTS_PER_SECOND=1

# ── Nova Fin reference data ─────────────────────────────────────
CURRENCY_PROVIDER=frankfurter
FRANKFURTER_API_BASE=https://api.frankfurter.dev/v2

# ── Syncori and media metadata ──────────────────────────────────
MUSIC_METADATA_PROVIDER=musicbrainz
MUSICBRAINZ_API_BASE=https://musicbrainz.org/ws/2
MUSICBRAINZ_USER_AGENT=AgenticMercuryTimeRunner/1.0
MUSICBRAINZ_MAX_REQUESTS_PER_SECOND=1
COVER_ART_API_BASE=https://coverartarchive.org

BOOK_PROVIDER=open-library
OPEN_LIBRARY_API_BASE=https://openlibrary.org
OPEN_LIBRARY_MAX_REQUESTS_PER_SECOND=1

# ── Browser-native device capabilities ─────────────────────────
VITE_ENABLE_WEB_SPEECH=1
VITE_ENABLE_MEDIA_DEVICES=1
VITE_ENABLE_MEDIA_RECORDER=1
VITE_ENABLE_WEB_AUDIO=1
VITE_ENABLE_SCREEN_CAPTURE=1
VITE_ENABLE_GEOLOCATION=1
VITE_ENABLE_BATTERY_STATUS=1
VITE_ENABLE_FILE_SYSTEM_ACCESS=1
VITE_ENABLE_WEB_BLUETOOTH=1
VITE_ENABLE_NOTIFICATIONS=1
VITE_ENABLE_WEB_SHARE=1
VITE_ENABLE_OFFLINE_PWA=1

# ── Optional commerce ───────────────────────────────────────────
# Stripe has no monthly API fee but charges transaction fees.
PAYMENTS_PROVIDER=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# ── Safety and cost controls ────────────────────────────────────
ALLOW_PAID_API_FALLBACK=0
EXTERNAL_API_CACHE_TTL_SECONDS=900
EXTERNAL_API_TIMEOUT_SECONDS=10
EXTERNAL_API_MAX_RETRIES=2
DAILY_AI_REQUEST_LIMIT=100
