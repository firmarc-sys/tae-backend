NODE_ENV=production
PORT=8080

# Canonical ARI / Mercury identity
SIOS_OWNER_GID=399152573423
ARI_REQUIRE_AUTH=true
ARI_SESSION_TTL_SECONDS=43200

# Public frontend origin used for Stripe return URLs.
PUBLIC_DOMAIN=https://siaas.space

# Store real secret values in Google Secret Manager and reference them from Cloud Run.
ARI_SESSION_SECRET=replace_with_secret_manager_reference_at_deploy_time
OWNER_ACCESS_CODE=replace_with_secret_manager_reference_at_deploy_time

# Neon Postgres is the canonical Jahorin Digital Twin persistence authority.
# Store the full connection string in Secret Manager; never commit the real value.
NEON_DATABASE_URL=replace_with_secret_manager_reference_at_deploy_time
NEON_POOL_MAX=5

# Neon Auth is already provisioned on the SIOS production branch.
# Better Auth-compatible endpoint and JWKS are public configuration, not secrets.
NEON_AUTH_URL=https://ep-fragrant-recipe-ak4pobky.neonauth.c-3.us-west-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-fragrant-recipe-ak4pobky.neonauth.c-3.us-west-2.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Legacy Supabase compatibility only. It is no longer required for Jahorin Twin persistence.
SUPABASE_URL=https://zrkkilsynurpgwrijicq.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Billing. Secret key and webhook secret are server-only.
STRIPE_SECRET_KEY=replace_with_secret_manager_reference_at_deploy_time
STRIPE_WEBHOOK_SECRET=replace_with_secret_manager_reference_at_deploy_time
STRIPE_PRICE_BETA=price_replace_with_beta_price_id
STRIPE_PRICE_ALPHA=price_replace_with_alpha_price_id

# Google Vertex AI is the preferred production provider on Cloud Run.
GOOGLE_CLOUD_PROJECT=689058655022
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# Optional Gemini Developer API fallback. Keep the real key only in deployment secrets.
GEMINI_API_KEY=

# Comma-separated browser origins allowed to call ARI directly.
# Netlify/Vercel production should normally use same-origin /api/* proxying.
ALLOWED_ORIGINS=https://jahorin-mercury.netlify.app,https://mercury-timerunner.netlify.app,https://siaas.netlify.app,https://main--siaas.netlify.app,https://siaas.space,https://www.siaas.space,https://myaihome.space,http://localhost:5173

# ARI bounded autonomy.
ARI_AUTONOMY_ENABLED=true
ARI_AUTONOMY_MAX_STEPS=8
ARI_AUTONOMY_MAX_RETRIES=2
ARI_AUTONOMY_SNAPSHOT_PATH=/tmp/ari-autonomy-state.json

# Cloud Tasks dispatch is optional.
ARI_PUBLIC_URL=https://ari-689058655022.us-west1.run.app
ARI_TASKS_LOCATION=us-west1
ARI_TASKS_QUEUE=ari-autonomy
ARI_TASKS_SERVICE_ACCOUNT=
ARI_WORKER_TOKEN=replace_with_secret_manager_reference_at_deploy_time
