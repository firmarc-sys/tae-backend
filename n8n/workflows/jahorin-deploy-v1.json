{"name":"Jahorin — Approved Deployment","nodes":[{"parameters":{"httpMethod":"POST","path":"jahorin/jahorin-deploy-v1","authentication":"headerAuth","responseMode":"responseNode","options":{}},"id":"b32c6e0c-d611-432f-aef2-af9133123b0f","name":"Jahorin Webhook","type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,0],"webhookId":"6b0fe53b-c1a0-4ba4-9064-11592713ada5","credentials":{"httpHeaderAuth":{"name":"Jahorin TAE Webhook"}}},{"parameters":{"jsCode":"const req = $json;\nconst body = req.body ?? req;\nconst required = ['tenant_id','workflow_id','invocation_id','idempotency_key','schema_version'];\nfor (const key of required) {\n  if (!body[key]) throw new Error(`Missing ${key}`);\n}\nif (!String(body.schema_version).startsWith('2.')) throw new Error('Unsupported Jahorin n8n schema');\nreturn [{\n  json: {\n    ...body,\n    received_at: new Date().toISOString(),\n    phase: 'acting',\n    input: body.input ?? {},\n    memory_context: Array.isArray(body.memory_context) ? body.memory_context : [],\n  }\n}];"},"id":"e7e64361-2434-4e47-af01-67afdf3ecee2","name":"Normalize TAE Envelope","type":"n8n-nodes-base.code","typeVersion":2,"position":[220,0]},{"parameters":{"jsCode":"const a=$json.approval;\nif (!a || !['approved','consumed'].includes(String(a.status))) throw new Error('TAE approval receipt required');\nreturn [{json:$json}];"},"id":"b0f1f318-b114-4b7d-aa5e-643a0086eb66","name":"Validate Human Approval","type":"n8n-nodes-base.code","typeVersion":2,"position":[450,0]},{"parameters":{"method":"POST","url":"={{ $vars.JAHORIN_RUNTIME_URL + '/api/runtime' }}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"content-type","value":"application/json"},{"name":"x-jahorin-tenant","value":"={{ $json.tenant_id }}"}]},"sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{ JSON.stringify({request_id:$json.invocation_id, capability:'deploy', operation:'deploy', human_confirmation:true, payload:$json.input, context:{task_id:$json.task_id,session_id:$json.session_id,idempotency_key:$json.idempotency_key}}) }}","options":{"timeout":55000}},"id":"c0f66f72-7d96-4949-a9e0-adf04136cfba","name":"Execute Backend Action","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[700,0],"credentials":{"httpHeaderAuth":{"name":"Jahorin Backend Service"}}},{"parameters":{"jsCode":"const result=$json;\nconst source=$('Validate Human Approval').first().json;\nconst providerId=result.deployment_id ?? result.revision ?? result.transaction_id ?? result.provider_reference ?? result.request_id ?? null;\nreturn [{json:{\n  workflow_id: source.workflow_id,\n  status:'completed',\n  result,\n  evidence:[{kind:'deployment',source:'jahorin-backend',at:new Date().toISOString(),provider_reference:providerId}],\n}}];"},"id":"fffa4d7c-ba35-49f7-a9e1-69cfc58d7098","name":"Build Verified Evidence","type":"n8n-nodes-base.code","typeVersion":2,"position":[950,0]},{"parameters":{"respondWith":"firstIncomingItem","options":{}},"id":"04acf49c-77cc-49ab-9e48-d658bd00ca28","name":"Respond to TAE","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[1200,0]}],"pinData":{},"connections":{"Jahorin Webhook":{"main":[[{"node":"Normalize TAE Envelope","type":"main","index":0}]]},"Normalize TAE Envelope":{"main":[[{"node":"Validate Human Approval","type":"main","index":0}]]},"Validate Human Approval":{"main":[[{"node":"Execute Backend Action","type":"main","index":0}]]},"Execute Backend Action":{"main":[[{"node":"Build Verified Evidence","type":"main","index":0}]]},"Build Verified Evidence":{"main":[[{"node":"Respond to TAE","type":"main","index":0}]]}},"active":false,"settings":{"executionOrder":"v1"},"versionId":"af786615-229d-4531-a879-39d990f9db24","meta":{"jahorin":{"workflow_id":"jahorin-deploy-v1","action_kind":"deployment","authority":"TAE","approval":"required","completion_gate":"Thoth","setup_required":["JAHORIN_RUNTIM